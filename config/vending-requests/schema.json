{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/azure-landing-zone-factory/vending-request.schema.json",
  "title": "Azure landing-zone subscription vending request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_name",
    "owner",
    "cost_center",
    "environment",
    "data_classification",
    "subscription_id",
    "management_group_destination",
    "connectivity_profile",
    "monthly_budget",
    "budget_start_date",
    "budget_contact_emails",
    "expiration_date",
    "log_analytics_workspace_id"
  ],
  "properties": {
    "application_name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$" },
    "owner": { "type": "string", "format": "email" },
    "cost_center": { "type": "string", "minLength": 2, "maxLength": 30 },
    "environment": { "enum": ["dev", "test", "stage", "prod", "sandbox"] },
    "data_classification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "subscription_id": { "type": "string", "format": "uuid" },
    "management_group_destination": { "enum": ["corp", "online", "local", "sandbox"] },
    "connectivity_profile": { "enum": ["isolated", "corp", "online"] },
    "monthly_budget": { "type": "number", "exclusiveMinimum": 0 },
    "budget_start_date": { "type": "string", "format": "date-time" },
    "budget_contact_emails": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "email" }
    },
    "expiration_date": { "type": "string", "format": "date-time" },
    "log_analytics_workspace_id": { "type": "string", "pattern": "^/subscriptions/.+/resourceGroups/.+/providers/Microsoft.OperationalInsights/workspaces/.+$" },
    "role_assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principal_id"],
        "properties": {
          "principal_id": { "type": "string", "format": "uuid" },
          "principal_type": { "enum": ["Group", "ServicePrincipal", "User"] },
          "role_definition_name": { "type": "string", "not": { "enum": ["Owner", "User Access Administrator", "Role Based Access Control Administrator"] } }
        }
      }
    },
    "additional_tags": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
